# ==========================================
# Go Binaries & Compiles
# ==========================================
# Explicit binary files produced by go build
/frontend/frontend
/student-service/student-service
*.exe
*.exe?
*.dll
*.so
*.dylib
*.test
*.out

# Go vendor directory (if you unexpectedly use vendoring)
/vendor/

# Air (Live reload) temporary files
/tmp/

# Local service data (databases, uploads)
**/data/

# ==========================================
# Protobuf / Buf (Optional)
# ==========================================
# If you want to force everyone to run `make generate` locally,
# you can uncomment the line below:
**/gen/

# Buf cache and local state
.buf/

# ==========================================
# Templ (Optional)
# ==========================================
# Force everyone to run `make generate` locally
**/*_templ.go

# ==========================================
# Environment Variables & Secrets
# ==========================================
# Sensitive information and local configurations
.env
.env.local
*.pem
*.key

# ==========================================
# Operating System Files
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ==========================================
# IDEs & Editors
# ==========================================
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# GoLand / IntelliJ
.idea/
*.iws
*.iml
*.ipr

# Vim
*.swp
*.swo
*~