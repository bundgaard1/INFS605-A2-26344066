package view

import "osbourne.local/frontend/internal/domain"

var toastOnce = templ.NewOnceHandle()

templ Base(user domain.User) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<title>Osborne.AI Portal</title>
			<link rel="stylesheet" href="/static/css/style.css"/>
		</head>
		<body>
			<div class="portal-shell">
				<header class="top-navbar">
					<h2>Osborne.AI Portal</h2>
					<div class="user-badge">{ user.Name } ({ user.Role })</div>
				</header>

				<nav class="side-navbar">
					<ul>
						<li><a href={ "/" }>Dashboard</a></li>
						<li><a href={ "/profile?id=" + user.ID }>Profile</a></li>
						<li><a href={ "/notifications?id=" + user.ID }>Notifications</a></li>
						<li><a href={ "/course-catalog" }>Course Catalog</a></li>
					</ul>
				</nav>

				<div class="main-container">
					<main class="content-canvas">
						{ children... }
					</main>
				</div>
			</div>

			<div id="toasts"></div>

			@toastOnce.Once() {
				<script>
					function showToast(message, kind) {
						var toasts = document.getElementById('toasts');
						if (!toasts) return;

						var toast = document.createElement('div');
						toast.className = 'toast toast-' + (kind === 'error' ? 'error' : 'success');
						toast.textContent = message;
						toasts.appendChild(toast);

						setTimeout(function () { toast.remove(); }, 3500);
					}
				</script>
			}
		</body>
	</html>
}
